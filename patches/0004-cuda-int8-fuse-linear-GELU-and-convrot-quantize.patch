+        // src: the linear's F32 result, rows x n. dst: the packed INT8 activation (rows, then the row scales).
+        static CUDAError gelu_quantize_launch(const Plan& p, CUDAStream stream, const float* src, int8_t* dst) {
+            if (p.padded > p.rows) {
+                auto error = cuda_memset_async(dst + p.n * p.rows, 0, size_t(p.n) * (p.padded - p.rows), stream);
+                if (error != cuda_success)
+                    return error;
+            }
+            static std::mutex mutex;
+            static std::unordered_map<int, bool> configured;
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                if (!configured[p.device.device]) {
+                    auto error = cuda_set_shared_memory(quantize_convrot<true>, int(p.device.shared_memory - 128));
+                    if (error != cuda_success)
+                        return error;
+                    configured[p.device.device] = true;
+                }
+            }
+            const int threads = p.n <= 1024 ? 128 : p.n <= 8192 ? 256
+                                                                : 1024;
+            quantize_convrot<true><<<unsigned(p.rows), threads, size_t(p.n) * sizeof(float), stream>>>(
+                src, dst, reinterpret_cast<float*>(dst + p.n * p.padded), p.n, p.rows, p.n);
+            return cuda_last_error();
+        }
