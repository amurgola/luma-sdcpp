diff --git a/src/model/diffusion/rd_flow.hpp b/src/model/diffusion/rd_flow.hpp
new file mode 100644
index 0000000..791d591
--- /dev/null
+++ b/src/model/diffusion/rd_flow.hpp
@@ -0,0 +1,629 @@
+#ifndef __SD_MODEL_DIFFUSION_RD_FLOW_HPP__
+#define __SD_MODEL_DIFFUSION_RD_FLOW_HPP__
+
+#include <cmath>
+#include <string>
+#include <vector>
+
+#include "core/ggml_extend.h"
+#include "core/ggml_runner.h"
+#include "core/util.h"
+#include "model/common/ggml_block.hpp"
+#include "model/diffusion/model.hpp"
+#include "model_loader.h"
+
+// Ref: https://github.com/Retro-Diffusion/rd-flow-64 (rdflow/model.py, rdflow/layers.py)
+//
+// RD Flow 64 is a pixel-space hourglass flow transformer over a 64x64 OKLab + alpha grid with a
+// palette-pointer head. One call runs one image (no batch); conditional and unconditional passes
+// are separate calls, and masked tokens (dropped text, unused palette slots) are left out instead
+// of masked, which is equivalent and needs no attention masks.
+
+namespace RDFlow {
+    constexpr int GRAPH_SIZE        = 40960;
+    constexpr int SIZE              = 64;
+    constexpr int CHANNELS          = 4;
+    constexpr int64_t D0            = 128;
+    constexpr int64_t D1            = 256;
+    constexpr int64_t DC            = 1024;
+    constexpr int HEAD_DIM          = 64;
+    constexpr int WINDOW            = 8;
+    constexpr int64_t TEXT_DIM      = 2560;
+    constexpr int N_REGISTERS       = 4;
+    constexpr int64_t DK            = 128;
+    constexpr int64_t COLOUR_HIDDEN = 256;
+    constexpr int COLOUR_FREQS      = 8;
+    constexpr int64_t COLOUR_FEATS  = 3 + 6 * COLOUR_FREQS;
+    constexpr int N_RAMPS           = 16;
+    constexpr int LEVEL_DEPTH       = 2;
+    constexpr int CORE_DEPTH        = 16;
+    constexpr int TEXT_ADAPTER      = 2;
+    constexpr float MLP_RATIO       = 3.f;
+    constexpr float ROPE_THETA      = 100.f;
+    constexpr int TIME_DIM          = 256;
+    constexpr int SOURCE            = 6;
+    constexpr int N_ATTRS           = 4;
+
+    // RMSNorm whose weight is named "w" (rdflow's own layer).
+    class RMSNormW : public UnaryBlock {
+        int64_t dim;
+
+        void init_params(ggml_context* ctx, const String2TensorStorage& = {}, const std::string = "") override {
+            params["w"] = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, dim);
+        }
+
+    public:
+        explicit RMSNormW(int64_t dim)
+            : dim(dim) {}
+
+        ggml_tensor* forward(GGMLRunnerContext* ctx, ggml_tensor* x) override {
+            return ggml_mul(ctx->ggml_ctx, ggml_rms_norm(ctx->ggml_ctx, x, 1e-6f), params["w"]);
+        }
+    };
+
+    // Depthwise 3x3 conv kept in F32: the network's activations overflow F16.
+    class DepthwiseConv3 : public UnaryBlock {
+        int64_t channels;
+
+        void init_params(ggml_context* ctx, const String2TensorStorage& = {}, const std::string = "") override {
+            params["weight"] = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 3, 3, 1, channels);
+            params["bias"]   = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, channels);
+        }
+
+    public:
+        explicit DepthwiseConv3(int64_t channels)
+            : channels(channels) {}
+
+        // x: [W, H, C, 1]
+        ggml_tensor* forward(GGMLRunnerContext* ctx, ggml_tensor* x) override {
+            auto out = ggml_conv_2d_dw_direct(ctx->ggml_ctx, params["weight"], x, 1, 1, 1, 1, 1, 1);
+            return ggml_add(ctx->ggml_ctx, out, ggml_reshape_4d(ctx->ggml_ctx, params["bias"], 1, 1, channels, 1));
+        }
+    };
+
+    static inline std::shared_ptr<Linear> linear(int64_t in, int64_t out, bool bias = true) {
+        return std::make_shared<Linear>(in, out, bias, true);
+    }
+
+    static inline ggml_tensor* row(GGMLRunnerContext* ctx, ggml_tensor* table, int64_t index) {
+        return ggml_view_1d(ctx->ggml_ctx, table, table->ne[0], index * table->nb[1]);
+    }
+
+    // torch.roll along one dim: out[i] = in[(i - shift) mod n].
+    static inline ggml_tensor* roll(GGMLRunnerContext* ctx, ggml_tensor* x, int dim, int64_t shift) {
+        const int64_t n = x->ne[dim];
+        shift           = ((shift % n) + n) % n;
+        if (shift == 0) {
+            return x;
+        }
+        auto tail = ggml_ext_slice(ctx, x, dim, n - shift, n);
+        auto head = ggml_ext_slice(ctx, x, dim, 0, n - shift);
+        return ggml_concat(ctx->ggml_ctx, tail, head, dim);
+    }
+
+    // x: [hd, heads, N, B]; cos/sin: [hd/2, 1, N, B'] with B a multiple of B'. Rotates (first half, second half).
+    static inline ggml_tensor* apply_rope(GGMLRunnerContext* ctx, ggml_tensor* x, ggml_tensor* cos, ggml_tensor* sin) {
+        auto gctx    = ctx->ggml_ctx;
+        int64_t half = cos->ne[0];
+        auto first   = ggml_ext_slice(ctx, x, 0, 0, half);
+        auto second  = ggml_ext_slice(ctx, x, 0, half, 2 * half);
+        auto left    = ggml_sub(gctx, ggml_mul(gctx, first, cos), ggml_mul(gctx, second, sin));
+        auto right   = ggml_add(gctx, ggml_mul(gctx, second, cos), ggml_mul(gctx, first, sin));
+        return ggml_concat(gctx, left, right, 0);
+    }
+
+    class Attention : public GGMLBlock {
+        int64_t dim;
+        int heads;
+
+    public:
+        explicit Attention(int64_t dim)
+            : dim(dim), heads(static_cast<int>(dim / HEAD_DIM)) {
+            blocks["qkv"] = linear(dim, 3 * dim, false);
+            blocks["out"] = linear(dim, dim, false);
+            blocks["qn"]  = std::make_shared<RMSNormW>(HEAD_DIM);
+            blocks["kn"]  = std::make_shared<RMSNormW>(HEAD_DIM);
+        }
+
+        // x: [dim, N, B]; cos/sin: [hd/2, 1, N, B'] or nullptr for no rotation.
+        ggml_tensor* forward(GGMLRunnerContext* ctx, ggml_tensor* x, ggml_tensor* cos, ggml_tensor* sin) {
+            auto gctx      = ctx->ggml_ctx;
+            const auto N   = x->ne[1];
+            const auto B   = x->ne[2];
+            auto qkv       = std::dynamic_pointer_cast<Linear>(blocks["qkv"])->forward(ctx, x);
+            auto split_one = [&](int index) {
+                auto t = ggml_ext_slice(ctx, qkv, 0, index * dim, (index + 1) * dim);
+                return ggml_reshape_4d(gctx, t, HEAD_DIM, heads, N, B);
+            };
+            auto q = std::dynamic_pointer_cast<RMSNormW>(blocks["qn"])->forward(ctx, split_one(0));
+            auto k = std::dynamic_pointer_cast<RMSNormW>(blocks["kn"])->forward(ctx, split_one(1));
+            auto v = split_one(2);
+            if (cos != nullptr) {
+                q = apply_rope(ctx, q, cos, sin);
+                k = apply_rope(ctx, k, cos, sin);
+            }
+            q      = ggml_reshape_3d(gctx, q, dim, N, B);
+            k      = ggml_reshape_3d(gctx, k, dim, N, B);
+            v      = ggml_reshape_3d(gctx, v, dim, N, B);
+            auto o = ggml_ext_attention_ext(ctx, q, k, v, heads, nullptr, false, false);
+            return std::dynamic_pointer_cast<Linear>(blocks["out"])->forward(ctx, o);
+        }
+    };
+
+    // SwiGLU; on grids the gated half runs through a depthwise 3x3 conv first.
+    class SwiGLU : public GGMLBlock {
+        int64_t hidden;
+        bool conv;
+
+    public:
+        SwiGLU(int64_t dim, bool conv)
+            : hidden(static_cast<int64_t>(dim * MLP_RATIO)), conv(conv) {
+            blocks["w1"] = linear(dim, 2 * hidden, false);
+            blocks["w2"] = linear(hidden, dim, false);
+            if (conv) {
+                blocks["conv"] = std::make_shared<DepthwiseConv3>(hidden);
+            }
+        }
+
+        // x: [dim, N]; side: grid side when conv.
+        ggml_tensor* forward(GGMLRunnerContext* ctx, ggml_tensor* x, int64_t side) {
+            auto gctx = ctx->ggml_ctx;
+            auto ag   = std::dynamic_pointer_cast<Linear>(blocks["w1"])->forward(ctx, x);
+            auto a    = ggml_ext_slice(ctx, ag, 0, 0, hidden);
+            auto g    = ggml_ext_slice(ctx, ag, 0, hidden, 2 * hidden);
+            if (conv) {
+                const auto N = a->ne[1];
+                auto grid    = ggml_reshape_4d(gctx, a, hidden, side, side, 1);
+                grid         = ggml_cont(gctx, ggml_permute(gctx, grid, 2, 0, 1, 3));  // [x, y, C, 1]
+                grid         = std::dynamic_pointer_cast<DepthwiseConv3>(blocks["conv"])->forward(ctx, grid);
+                grid         = ggml_cont(gctx, ggml_permute(gctx, grid, 1, 2, 0, 3));  // [C, x, y, 1]
+                a            = ggml_reshape_2d(gctx, grid, hidden, N);
+            }
+            return std::dynamic_pointer_cast<Linear>(blocks["w2"])->forward(ctx, ggml_mul(gctx, ggml_silu(gctx, g), a));
+        }
+    };
+
+    // Pre-norm block with adaLN-single modulation: mod (shared per level) plus this block's table.
+    class Block : public GGMLBlock {
+        int64_t dim;
+
+        void init_params(ggml_context* ctx, const String2TensorStorage& = {}, const std::string = "") override {
+            params["table"] = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, dim, 6);
+        }
+
+    public:
+        Block(int64_t dim, bool conv)
+            : dim(dim) {
+            blocks["n1"]   = std::make_shared<RMSNormW>(dim);
+            blocks["n2"]   = std::make_shared<RMSNormW>(dim);
+            blocks["attn"] = std::make_shared<Attention>(dim);
+            blocks["mlp"]  = std::make_shared<SwiGLU>(dim, conv);
+        }
+
+        Attention* attention() { return std::dynamic_pointer_cast<Attention>(blocks["attn"]).get(); }
+
+        // x: [dim, N]; mod: [dim, 6] or nullptr (zero); attn: h -> attention output.
+        template <typename AttnFn>
+        ggml_tensor* forward(GGMLRunnerContext* ctx, ggml_tensor* x, ggml_tensor* mod, AttnFn attn, int64_t side) {
+            auto gctx   = ctx->ggml_ctx;
+            auto m      = mod != nullptr ? ggml_add(gctx, mod, params["table"]) : params["table"];
+            auto adapt  = [&](ggml_tensor* h, int shift_row, int scale_row) {
+                h = ggml_add(gctx, h, ggml_mul(gctx, h, row(ctx, m, scale_row)));
+                return ggml_add(gctx, h, row(ctx, m, shift_row));
+            };
+            auto n1 = std::dynamic_pointer_cast<RMSNormW>(blocks["n1"])->forward(ctx, x);
+            x       = ggml_add(gctx, x, ggml_mul(gctx, attn(adapt(n1, 0, 1)), row(ctx, m, 2)));
+            auto n2 = std::dynamic_pointer_cast<RMSNormW>(blocks["n2"])->forward(ctx, x);
+            auto mo = std::dynamic_pointer_cast<SwiGLU>(blocks["mlp"])->forward(ctx, adapt(n2, 3, 4), side);
+            return ggml_add(gctx, x, ggml_mul(gctx, mo, row(ctx, m, 5)));
+        }
+    };
+
+    struct WindowRope {
+        ggml_tensor* cos[2];
+        ggml_tensor* sin[2];
+    };
+
+    // Window-attention blocks on an n x n grid, shifted windows on odd blocks.
+    class WindowLevel : public GGMLBlock {
+        int64_t dim;
+        int64_t side;
+
+        ggml_tensor* windows(GGMLRunnerContext* ctx, ggml_tensor* h, int64_t shift) {
+            auto gctx      = ctx->ggml_ctx;
+            const auto nw  = side / WINDOW;
+            auto g         = ggml_reshape_3d(gctx, h, dim, side, side);
+            g              = roll(ctx, roll(ctx, g, 1, -shift), 2, -shift);
+            g              = ggml_reshape_4d(gctx, ggml_cont(gctx, g), dim * WINDOW, nw, WINDOW, nw);
+            g              = ggml_cont(gctx, ggml_permute(gctx, g, 0, 2, 1, 3));
+            return ggml_reshape_3d(gctx, g, dim, WINDOW * WINDOW, nw * nw);
+        }
+
+        ggml_tensor* unwindows(GGMLRunnerContext* ctx, ggml_tensor* o, int64_t shift) {
+            auto gctx     = ctx->ggml_ctx;
+            const auto nw = side / WINDOW;
+            auto g        = ggml_reshape_4d(gctx, ggml_cont(gctx, o), dim * WINDOW, WINDOW, nw, nw);
+            g             = ggml_cont(gctx, ggml_permute(gctx, g, 0, 2, 1, 3));
+            g             = ggml_reshape_3d(gctx, g, dim, side, side);
+            g             = roll(ctx, roll(ctx, g, 1, shift), 2, shift);
+            return ggml_reshape_2d(gctx, ggml_cont(gctx, g), dim, side * side);
+        }
+
+    public:
+        WindowLevel(int64_t dim, int64_t side)
+            : dim(dim), side(side) {
+            for (int i = 0; i < LEVEL_DEPTH; ++i) {
+                blocks["blocks." + std::to_string(i)] = std::make_shared<Block>(dim, true);
+            }
+            blocks["ada"] = linear(DC, 6 * dim);
+        }
+
+        // x: [dim, side*side]; c: [DC]
+        ggml_tensor* forward(GGMLRunnerContext* ctx, ggml_tensor* x, ggml_tensor* c, const WindowRope& rope) {
+            auto gctx = ctx->ggml_ctx;
+            auto mod  = std::dynamic_pointer_cast<Linear>(blocks["ada"])->forward(ctx, ggml_silu(gctx, c));
+            mod       = ggml_reshape_2d(gctx, mod, dim, 6);
+            for (int i = 0; i < LEVEL_DEPTH; ++i) {
+                const int odd     = i % 2;
+                const auto shift  = odd ? WINDOW / 2 : 0;
+                auto block        = std::dynamic_pointer_cast<Block>(blocks["blocks." + std::to_string(i)]);
+                auto window_attn  = [&](ggml_tensor* h) {
+                    auto o = block->attention()->forward(ctx, windows(ctx, h, shift), rope.cos[odd], rope.sin[odd]);
+                    return unwindows(ctx, o, shift);
+                };
+                x = block->forward(ctx, x, mod, window_attn, side);
+            }
+            return x;
+        }
+    };
+
+    // [D, n*n] -> [4D, (n/2)^2], 2x2 patches (iy, ix, D order).
+    static inline ggml_tensor* merge(GGMLRunnerContext* ctx, ggml_tensor* x, int64_t side) {
+        auto gctx    = ctx->ggml_ctx;
+        const auto D = x->ne[0];
+        auto g       = ggml_reshape_4d(gctx, x, D * 2, side / 2, 2, side / 2);
+        g            = ggml_cont(gctx, ggml_permute(gctx, g, 0, 2, 1, 3));
+        return ggml_reshape_2d(gctx, g, 4 * D, (side / 2) * (side / 2));
+    }
+
+    // [4D, (n/2)^2] -> [D, n*n]
+    static inline ggml_tensor* split(GGMLRunnerContext* ctx, ggml_tensor* x, int64_t side) {
+        auto gctx    = ctx->ggml_ctx;
+        const auto D = x->ne[0] / 4;
+        auto g       = ggml_reshape_4d(gctx, x, D * 2, 2, side / 2, side / 2);
+        g            = ggml_cont(gctx, ggml_permute(gctx, g, 0, 2, 1, 3));
+        return ggml_reshape_2d(gctx, g, D, side * side);
+    }
+
+    struct ForwardInputs {
+        ggml_tensor* x;          // [4, 4096]
+        ggml_tensor* sc;         // [4, 4096]
+        ggml_tensor* temb;       // [256]
+        ggml_tensor* text;       // [2560, L] or nullptr (unconditional)
+        ggml_tensor* pooled;     // [2560] or nullptr (unconditional)
+        ggml_tensor* style;      // I32 [1]
+        ggml_tensor* source;     // I32 [1]
+        ggml_tensor* attr;       // I32 [1]
+        ggml_tensor* bg;         // I32 [1]
+        ggml_tensor* pal_feats;  // [51, P] or nullptr
+        ggml_tensor* pal_ramp;   // I32 [P]
+        ggml_tensor* pal_level;  // [1, P]
+        WindowRope rope0;
+        WindowRope rope1;
+        ggml_tensor* core_cos;  // [32, 1, S + 256, 1]
+        ggml_tensor* core_sin;
+    };
+
+    class RDFlowModel : public GGMLBlock {
+        void init_params(ggml_context* ctx, const String2TensorStorage& = {}, const std::string = "") override {
+            params["null_text"] = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, TEXT_DIM, 1);
+            params["registers"] = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, DC, N_REGISTERS);
+            params["modality"]  = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, DC, 4);
+        }
+
+        template <typename T>
+        T* get(const std::string& name) { return std::dynamic_pointer_cast<T>(blocks[name]).get(); }
+
+        ggml_tensor* lin(GGMLRunnerContext* ctx, const std::string& name, ggml_tensor* x) {
+            return get<Linear>(name)->forward(ctx, x);
+        }
+
+        ggml_tensor* mlp2(GGMLRunnerContext* ctx, const std::string& name, ggml_tensor* x) {
+            return lin(ctx, name + ".2", ggml_silu(ctx->ggml_ctx, lin(ctx, name + ".0", x)));
+        }
+
+        // Palette colours -> [COLOUR_HIDDEN, P]: Fourier OKLab MLP + ramp id + level on the ramp.
+        ggml_tensor* palette_embed(GGMLRunnerContext* ctx, const ForwardInputs& in) {
+            auto gctx = ctx->ggml_ctx;
+            auto e    = mlp2(ctx, "colour.mlp", in.pal_feats);
+            e         = ggml_add(gctx, e, get<Embedding>("ramp_emb")->forward(ctx, in.pal_ramp));
+            return ggml_add(gctx, e, lin(ctx, "level_proj", in.pal_level));
+        }
+
+    public:
+        RDFlowModel() {
+            blocks["inp"]   = linear(CHANNELS * 2, D0);
+            blocks["t_mlp.0"] = linear(TIME_DIM, DC);
+            blocks["t_mlp.2"] = linear(DC, DC);
+            blocks["style"]     = std::make_shared<Embedding>(512, DC);
+            blocks["source"]    = std::make_shared<Embedding>(16, DC);
+            blocks["text_pool"] = linear(TEXT_DIM, DC);
+            blocks["text_proj"] = linear(TEXT_DIM, DC);
+            const int attr_vocab[N_ATTRS] = {8, 5, 5, 4};
+            for (int j = 0; j < N_ATTRS; ++j) {
+                blocks["attr_emb." + std::to_string(j)] = std::make_shared<Embedding>(attr_vocab[j], DC);
+            }
+            blocks["bg_emb"] = std::make_shared<Embedding>(3, DC);
+            for (int i = 0; i < TEXT_ADAPTER; ++i) {
+                blocks["adapter." + std::to_string(i)] = std::make_shared<Block>(DC, false);
+            }
+            blocks["down0"]  = std::make_shared<WindowLevel>(D0, SIZE);
+            blocks["merge0"] = linear(4 * D0, D1);
+            blocks["down1"]  = std::make_shared<WindowLevel>(D1, SIZE / 2);
+            blocks["merge1"] = linear(4 * D1, DC);
+            for (int i = 0; i < CORE_DEPTH; ++i) {
+                blocks["core." + std::to_string(i)] = std::make_shared<Block>(DC, false);
+            }
+            blocks["core_ada"]    = linear(DC, 6 * DC);
+            blocks["split1"]      = linear(DC, 4 * D1);
+            blocks["skip1"]       = linear(2 * D1, D1);
+            blocks["up1"]         = std::make_shared<WindowLevel>(D1, SIZE / 2);
+            blocks["split0"]      = linear(D1, 4 * D0);
+            blocks["skip0"]       = linear(2 * D0, D0);
+            blocks["up0"]         = std::make_shared<WindowLevel>(D0, SIZE);
+            blocks["out_norm"]    = std::make_shared<RMSNormW>(D0);
+            blocks["x_head"]      = linear(D0, CHANNELS);
+            blocks["colour.mlp.0"] = linear(COLOUR_FEATS, COLOUR_HIDDEN);
+            blocks["colour.mlp.2"] = linear(COLOUR_HIDDEN, COLOUR_HIDDEN);
+            blocks["ramp_emb"]     = std::make_shared<Embedding>(N_RAMPS, COLOUR_HIDDEN);
+            blocks["level_proj"]   = linear(1, COLOUR_HIDDEN);
+            blocks["pal_tok"]      = linear(COLOUR_HIDDEN, DC);
+            blocks["q"]            = linear(D0, DK);
+            blocks["k.0"]          = linear(COLOUR_HIDDEN, DK);
+            blocks["k.2"]          = linear(DK, DK);
+            blocks["transparent"]  = linear(D0, 1);
+        }
+
+        // Returns [4*4096 + (1+P)*4096]: the predicted clean image, then the pointer logits when a palette is given.
+        ggml_tensor* forward(GGMLRunnerContext* ctx, const ForwardInputs& in) {
+            auto gctx      = ctx->ggml_ctx;
+            const int64_t N0 = SIZE * SIZE;
+            const int64_t nc = SIZE / 4;
+
+            auto text   = in.text != nullptr ? in.text : params["null_text"];
+            auto pooled = in.pooled != nullptr ? in.pooled : ggml_reshape_1d(gctx, params["null_text"], TEXT_DIM);
+            auto c      = mlp2(ctx, "t_mlp", in.temb);
+            c           = ggml_add(gctx, c, get<Embedding>("style")->forward(ctx, in.style));
+            c           = ggml_add(gctx, c, get<Embedding>("source")->forward(ctx, in.source));
+            c           = ggml_add(gctx, c, lin(ctx, "text_pool", pooled));
+            for (int j = 0; j < N_ATTRS; ++j) {
+                c = ggml_add(gctx, c, get<Embedding>("attr_emb." + std::to_string(j))->forward(ctx, in.attr));
+            }
+            c = ggml_add(gctx, c, get<Embedding>("bg_emb")->forward(ctx, in.bg));
+            c = ggml_reshape_1d(gctx, c, DC);
+
+            auto xin = ggml_concat(gctx, in.x, in.sc, 0);
+            auto h0  = get<WindowLevel>("down0")->forward(ctx, lin(ctx, "inp", xin), c, in.rope0);
+            auto h1  = get<WindowLevel>("down1")->forward(ctx, lin(ctx, "merge0", merge(ctx, h0, SIZE)), c, in.rope1);
+
+            auto txt = lin(ctx, "text_proj", text);
+            for (int i = 0; i < TEXT_ADAPTER; ++i) {
+                auto block = get<Block>("adapter." + std::to_string(i));
+                auto attn  = [&](ggml_tensor* h) {
+                    auto o = block->attention()->forward(ctx, ggml_reshape_3d(gctx, h, DC, h->ne[1], 1), nullptr, nullptr);
+                    return ggml_reshape_2d(gctx, o, DC, h->ne[1]);
+                };
+                txt = block->forward(ctx, txt, nullptr, attn, 0);
+            }
+            auto hc = lin(ctx, "merge1", merge(ctx, h1, SIZE / 2));
+
+            auto modality = params["modality"];
+            auto tok      = ggml_add(gctx, params["registers"], row(ctx, modality, 0));
+            tok           = ggml_concat(gctx, tok, ggml_add(gctx, txt, row(ctx, modality, 1)), 1);
+            ggml_tensor* pal_embed = nullptr;
+            if (in.pal_feats != nullptr) {
+                pal_embed = palette_embed(ctx, in);
+                tok       = ggml_concat(gctx, tok, ggml_add(gctx, lin(ctx, "pal_tok", pal_embed), row(ctx, modality, 3)), 1);
+            }
+            const int64_t S = tok->ne[1];
+            tok             = ggml_concat(gctx, tok, ggml_add(gctx, hc, row(ctx, modality, 2)), 1);
+
+            auto mod = ggml_reshape_2d(gctx, lin(ctx, "core_ada", ggml_silu(gctx, c)), DC, 6);
+            for (int i = 0; i < CORE_DEPTH; ++i) {
+                auto block = get<Block>("core." + std::to_string(i));
+                auto attn  = [&](ggml_tensor* h) {
+                    auto o = block->attention()->forward(ctx, ggml_reshape_3d(gctx, h, DC, h->ne[1], 1), in.core_cos, in.core_sin);
+                    return ggml_reshape_2d(gctx, o, DC, h->ne[1]);
+                };
+                tok = block->forward(ctx, tok, mod, attn, 0);
+            }
+            hc = ggml_ext_slice(ctx, tok, 1, S, S + nc * nc);
+
+            auto u1 = split(ctx, lin(ctx, "split1", hc), SIZE / 2);
+            u1      = get<WindowLevel>("up1")->forward(ctx, lin(ctx, "skip1", ggml_concat(gctx, u1, h1, 0)), c, in.rope1);
+            auto u0 = split(ctx, lin(ctx, "split0", u1), SIZE);
+            u0      = get<WindowLevel>("up0")->forward(ctx, lin(ctx, "skip0", ggml_concat(gctx, u0, h0, 0)), c, in.rope0);
+            u0      = get<RMSNormW>("out_norm")->forward(ctx, u0);
+
+            auto out = ggml_reshape_1d(gctx, lin(ctx, "x_head", u0), CHANNELS * N0);
+            if (pal_embed != nullptr) {
+                auto keys   = mlp2(ctx, "k", pal_embed);                                     // [DK, P]
+                auto query  = lin(ctx, "q", u0);                                             // [DK, N0]
+                auto logits = ggml_mul_mat(gctx, keys, query);                               // [P, N0]
+                logits      = ggml_scale(gctx, logits, 1.f / std::sqrt(static_cast<float>(DK)));
+                logits      = ggml_concat(gctx, lin(ctx, "transparent", u0), logits, 0);  // [1 + P, N0]
+                out         = ggml_concat(gctx, out, ggml_reshape_1d(gctx, ggml_cont(gctx, logits), ggml_nelements(logits)), 0);
+            }
+            return out;
+        }
+    };
+
+    // Host-side inputs of one network call.
+    struct CallInputs {
+        sd::Tensor<float> x;          // {4, 64, 64}
+        sd::Tensor<float> sc;         // {4, 64, 64}
+        float t                  = 0.f;
+        bool conditional         = true;
+        bool transparent         = true;
+        sd::Tensor<float> pal_feats;  // {51, P} or empty
+        sd::Tensor<int32_t> pal_ramp; // {P}
+        sd::Tensor<float> pal_level;  // {1, P}
+    };
+
+    struct RDFlowRunner : public DiffusionModelRunner {
+        RDFlowModel model;
+        sd::Tensor<float> text_;     // {2560, L}
+        sd::Tensor<float> pooled_;   // {2560}
+        sd::Tensor<float> window_cos_[2][2];
+        sd::Tensor<float> window_sin_[2][2];
+
+        RDFlowRunner(ggml_backend_t backend,
+                     const String2TensorStorage& tensors,
+                     const std::string& prefix,
+                     std::shared_ptr<RunnerWeightManager> weight_manager = nullptr)
+            : DiffusionModelRunner(backend, prefix, weight_manager) {
+            model.init(params_ctx, tensors, prefix);
+            for (int level = 0; level < 2; ++level) {
+                for (int odd = 0; odd < 2; ++odd) {
+                    build_window_rope(SIZE >> level, odd ? WINDOW / 2 : 0, window_cos_[level][odd], window_sin_[level][odd]);
+                }
+            }
+        }
+
+        std::string get_desc() override { return "rd_flow"; }
+
+        void get_param_tensors(std::map<std::string, ggml_tensor*>& tensors, const std::string& prefix) override {
+            model.get_param_tensors(tensors, prefix);
+        }
+
+        sd::Tensor<float> compute(int, const DiffusionParams&) override {
+            LOG_ERROR("RD Flow 64 runs through its own sampler, not the generic denoiser");
+            return {};
+        }
+
+        // features: {2560, L} prompt features (already RMS-normalised and bf16-rounded).
+        void set_text(const sd::Tensor<float>& features) {
+            text_            = features;
+            const int64_t L  = features.shape()[1];
+            pooled_          = sd::Tensor<float>::zeros({TEXT_DIM});
+            for (int64_t i = 0; i < L; ++i) {
+                for (int64_t d = 0; d < TEXT_DIM; ++d) {
+                    pooled_.data()[d] += features.data()[i * TEXT_DIM + d];
+                }
+            }
+            for (int64_t d = 0; d < TEXT_DIM; ++d) {
+                pooled_.data()[d] /= static_cast<float>(std::max<int64_t>(L, 1));
+            }
+        }
+
+        // One network call. Returns [4*4096 (+ (1+P)*4096 pointer logits)].
+        sd::Tensor<float> run(int n_threads, const CallInputs& in) {
+            sd::Tensor<float> temb = timestep_embedding(in.t);
+            sd::Tensor<int32_t> style({1}, std::vector<int32_t>{0});
+            sd::Tensor<int32_t> source({1}, std::vector<int32_t>{SOURCE});
+            sd::Tensor<int32_t> attr({1}, std::vector<int32_t>{0});
+            sd::Tensor<int32_t> bg({1}, std::vector<int32_t>{in.transparent ? 2 : 1});
+            const int64_t P   = in.pal_feats.empty() ? 0 : in.pal_feats.shape()[1];
+            const int64_t L   = in.conditional ? text_.shape()[1] : 1;
+            const int64_t S   = N_REGISTERS + L + P;
+            sd::Tensor<float> core_cos, core_sin;
+            build_core_rope(S, core_cos, core_sin);
+
+            auto graph = [&]() {
+                auto gf = new_graph_custom(GRAPH_SIZE);
+                auto ctx = get_context();
+                ForwardInputs fi{};
+                fi.x      = ggml_reshape_2d(ctx.ggml_ctx, make_input(in.x), CHANNELS, SIZE * SIZE);
+                fi.sc     = ggml_reshape_2d(ctx.ggml_ctx, make_input(in.sc), CHANNELS, SIZE * SIZE);
+                fi.temb   = make_input(temb);
+                fi.text   = in.conditional ? make_input(text_) : nullptr;
+                fi.pooled = in.conditional ? make_input(pooled_) : nullptr;
+                fi.style  = make_input(style);
+                fi.source = make_input(source);
+                fi.attr   = make_input(attr);
+                fi.bg     = make_input(bg);
+                if (P > 0) {
+                    fi.pal_feats = make_input(in.pal_feats);
+                    fi.pal_ramp  = make_input(in.pal_ramp);
+                    fi.pal_level = make_input(in.pal_level);
+                }
+                for (int odd = 0; odd < 2; ++odd) {
+                    fi.rope0.cos[odd] = make_input(window_cos_[0][odd]);
+                    fi.rope0.sin[odd] = make_input(window_sin_[0][odd]);
+                    fi.rope1.cos[odd] = make_input(window_cos_[1][odd]);
+                    fi.rope1.sin[odd] = make_input(window_sin_[1][odd]);
+                }
+                fi.core_cos = make_input(core_cos);
+                fi.core_sin = make_input(core_sin);
+                auto out    = model.forward(&ctx, fi);
+                ggml_build_forward_expand(gf, out);
+                return gf;
+            };
+            return take_or_empty(GGMLRunner::compute(graph, n_threads, false));
+        }
+
+    private:
+        static sd::Tensor<float> timestep_embedding(float t) {
+            const int half = TIME_DIM / 2;
+            std::vector<float> v(TIME_DIM);
+            for (int i = 0; i < half; ++i) {
+                float f      = std::exp(-std::log(10000.f) * static_cast<float>(i) / static_cast<float>(half));
+                float a      = t * 1000.f * f;
+                v[i]         = std::sin(a);
+                v[half + i]  = std::cos(a);
+            }
+            return sd::Tensor<float>({TIME_DIM}, std::move(v));
+        }
+
+        // cos/sin [hd/2] of one 2-D position (first quarter x, second quarter y); identity without a position.
+        static void rope_row(float px, float py, bool has, float* cos_out, float* sin_out) {
+            const int quarter = HEAD_DIM / 4;
+            for (int j = 0; j < quarter; ++j) {
+                float freq       = std::pow(ROPE_THETA, -static_cast<float>(j) / static_cast<float>(quarter));
+                float ax         = has ? px * freq : 0.f;
+                float ay         = has ? py * freq : 0.f;
+                cos_out[j]           = std::cos(ax);
+                sin_out[j]           = std::sin(ax);
+                cos_out[quarter + j] = std::cos(ay);
+                sin_out[quarter + j] = std::sin(ay);
+            }
+        }
+
+        // Tables in window layout: [hd/2, 1, w*w, nw*nw]; a token at window (wx, wy), cell (ix, iy) sits at the
+        // rolled grid position ((wx*w + ix + shift) mod n, (wy*w + iy + shift) mod n).
+        static void build_window_rope(int side, int shift, sd::Tensor<float>& cos, sd::Tensor<float>& sin) {
+            const int half = HEAD_DIM / 2;
+            const int nw   = side / WINDOW;
+            cos            = sd::Tensor<float>::zeros({half, 1, WINDOW * WINDOW, nw * nw});
+            sin            = sd::Tensor<float>::zeros({half, 1, WINDOW * WINDOW, nw * nw});
+            for (int wy = 0; wy < nw; ++wy) {
+                for (int wx = 0; wx < nw; ++wx) {
+                    for (int iy = 0; iy < WINDOW; ++iy) {
+                        for (int ix = 0; ix < WINDOW; ++ix) {
+                            const int x      = (wx * WINDOW + ix + shift) % side;
+                            const int y      = (wy * WINDOW + iy + shift) % side;
+                            const int64_t at = (static_cast<int64_t>(wy * nw + wx) * WINDOW * WINDOW + iy * WINDOW + ix) * half;
+                            rope_row(static_cast<float>(x), static_cast<float>(y), true, cos.data() + at, sin.data() + at);
+                        }
+                    }
+                }
+            }
+        }
+
+        // Core tables: S position-less tokens, then the 16x16 grid.
+        static void build_core_rope(int64_t S, sd::Tensor<float>& cos, sd::Tensor<float>& sin) {
+            const int half   = HEAD_DIM / 2;
+            const int nc     = SIZE / 4;
+            const int64_t n  = S + nc * nc;
+            cos              = sd::Tensor<float>::zeros({half, 1, n, 1});
+            sin              = sd::Tensor<float>::zeros({half, 1, n, 1});
+            for (int64_t i = 0; i < n; ++i) {
+                const bool has = i >= S;
+                const int g    = static_cast<int>(has ? i - S : 0);
+                rope_row(static_cast<float>(g % nc), static_cast<float>(g / nc), has, cos.data() + i * half, sin.data() + i * half);
+            }
+        }
+    };
+}  // namespace RDFlow
+
+#endif  // __SD_MODEL_DIFFUSION_RD_FLOW_HPP__
diff --git a/src/model/integrations/rd_flow.cpp b/src/model/integrations/rd_flow.cpp
new file mode 100644
index 0000000..79e54d1
--- /dev/null
+++ b/src/model/integrations/rd_flow.cpp
@@ -0,0 +1,31 @@
+#include "model/diffusion/rd_flow.hpp"
+#include "conditioning/conditioner.hpp"
+#include "model_definition.h"
+#include "pipeline/model_builders.h"
+
+static bool build_rd_flow(const sd::model_builders::Context& ctx, const TokenizerConfig& tokenizers, sd::model_builders::CoreRunners& result) {
+    result.conditioner = std::make_shared<LLMEmbedder>(ctx.backends.runtime_backend(SDBackendModule::TE),
+                                                       ctx.tensor_storage_map, ctx.version, "", false, ctx.weight_manager, tokenizers);
+    result.diffusion   = std::make_shared<RDFlow::RDFlowRunner>(ctx.backends.runtime_backend(SDBackendModule::DIFFUSION),
+                                                                ctx.tensor_storage_map, "model.diffusion_model", ctx.weight_manager);
+    return true;
+}
+
+const std::vector<ModelDefinition>& rd_flow_definitions() {
+    static const std::vector<ModelDefinition> definitions = [] {
+        std::vector<ModelDefinition> result;
+        {
+            ModelDefinition definition;
+            definition.version         = VERSION_RD_FLOW_64;
+            definition.geometry        = {1, 3, 3};
+            definition.name            = "RD Flow 64";
+            definition.traits.is_dit   = true;
+            definition.traits.fake_vae = true;
+            definition.sampling        = {FLOW_PRED, 3.f};
+            definition.build           = build_rd_flow;
+            result.push_back(std::move(definition));
+        }
+        return result;
+    }();
+    return definitions;
+}
