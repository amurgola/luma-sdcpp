+namespace sd::pipeline {
+    namespace {
+        constexpr int N_PIX            = RDFlow::SIZE * RDFlow::SIZE;
+        constexpr float AB_SCALE       = 3.f;
+        constexpr float FLOW_SHIFT     = 3.f;
+        constexpr float GUIDE_FROM     = 0.f;
+        constexpr float GUIDE_UNTIL    = 0.9f;
+        constexpr float PALETTE_AT     = 0.6f;
+        constexpr float POINTER_FROM   = 0.35f;
+        constexpr float COMMIT_FROM    = 0.55f;
+        constexpr float COMMIT_THRESH  = 0.9f;
+        constexpr int MAX_COLOURS      = 64;
+        constexpr double MERGE         = 0.05;
+        constexpr double BIN_SIZE      = 0.015;
+        constexpr int KMEANS_ITERS     = 4;
+        constexpr int MAX_PALETTE      = 256;
+        constexpr float NEUTRAL_C      = 0.035f;
+        constexpr int MAX_RAMPS        = 15;
+        constexpr double PI            = 3.14159265358979323846;
+
+        using RGB = std::array<int, 3>;
+
+        float srgb_channel_linear(float c) {
+            return c <= 0.04045f ? c / 12.92f : std::pow((c + 0.055f) / 1.055f, 2.4f);
+        }
+
+        // ColourEmbed.oklab: float32, cube root of the clamped LMS.
+        std::array<float, 3> oklab_f32(const RGB& rgb) {
+            float r = srgb_channel_linear(rgb[0] / 255.f);
+            float g = srgb_channel_linear(rgb[1] / 255.f);
+            float b = srgb_channel_linear(rgb[2] / 255.f);
+            float l = std::pow(std::max(0.4122214708f * r + 0.5363325363f * g + 0.0514459929f * b, 0.f), 1.f / 3.f);
+            float m = std::pow(std::max(0.2119034982f * r + 0.6806995451f * g + 0.1073969566f * b, 0.f), 1.f / 3.f);
+            float s = std::pow(std::max(0.0883024619f * r + 0.2817188376f * g + 0.6299787005f * b, 0.f), 1.f / 3.f);
+            return {0.2104542553f * l + 0.7936177850f * m - 0.0040720468f * s,
+                    1.9779984951f * l - 2.4285922050f * m + 0.4505937099f * s,
+                    0.0259040371f * l + 0.7827717662f * m - 0.8086757660f * s};
+        }
+
+        // palette.srgb_to_oklab: float64 math, float32 out.
+        std::array<float, 3> oklab_f64(const RGB& rgb) {
+            auto lin = [](double c) { return c <= 0.04045 ? c / 12.92 : std::pow((c + 0.055) / 1.055, 2.4); };
+            double r = lin(rgb[0] / 255.0), g = lin(rgb[1] / 255.0), b = lin(rgb[2] / 255.0);
+            double l = std::cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
+            double m = std::cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
+            double s = std::cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
+            return {static_cast<float>(0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s),
+                    static_cast<float>(1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s),
+                    static_cast<float>(0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)};
+        }
+
+        // flow.oklab_to_srgb: float32 math, rounded half to even.
+        RGB oklab_to_srgb(float L, float a, float b) {
+            float l  = std::pow(L + 0.3963377774f * a + 0.2158037573f * b, 3.f);
+            float m  = std::pow(L - 0.1055613458f * a - 0.0638541728f * b, 3.f);
+            float s  = std::pow(L - 0.0894841775f * a - 1.2914855480f * b, 3.f);
+            float c[3] = {4.0767416621f * l - 3.3077115913f * m + 0.2309699292f * s,
+                          -1.2684380046f * l + 2.6097574011f * m - 0.3413193965f * s,
+                          -0.0041960863f * l - 0.7034186147f * m + 1.7076147010f * s};
+            RGB out;
+            for (int i = 0; i < 3; ++i) {
+                float v = std::min(std::max(c[i], 0.f), 1.f);
+                v       = v <= 0.0031308f ? v * 12.92f : 1.055f * std::pow(std::max(v, 1e-12f), 1.f / 2.4f) - 0.055f;
+                out[i]  = static_cast<int>(std::nearbyint(v * 255.f));
+            }
+            return out;
+        }
+
+        std::vector<double> unwrap(const std::vector<double>& p) {
+            std::vector<double> out(p);
+            double correction = 0.0;
+            for (size_t i = 1; i < p.size(); ++i) {
+                double d  = p[i] - p[i - 1];
+                double dd = std::fmod(d + PI, 2 * PI);
+                if (dd < 0) {
+                    dd += 2 * PI;
+                }
+                dd -= PI;
+                if (dd == -PI && d > 0) {
+                    dd = PI;
+                }
+                if (std::fabs(d) >= PI) {
+                    correction += dd - d;
+                }
+                out[i] = p[i] + correction;
+            }
+            return out;
+        }
+
+        // ramps.ramps: greys are ramp 0; chromatic colours group by hue, each group ordered dark to light.
+        void palette_ramps(const std::vector<std::array<float, 3>>& lab, std::vector<int>& ramp, std::vector<float>& level) {
+            const double hue_gap  = 28.0 * PI / 180.0;
+            const double hue_span = 75.0 * PI / 180.0;
+            const size_t n        = lab.size();
+            ramp.assign(n, 0);
+            level.assign(n, 0.5f);
+            std::vector<double> hue(n);
+            std::vector<size_t> chromatic, neutral;
+            for (size_t i = 0; i < n; ++i) {
+                float chroma = std::hypot(lab[i][1], lab[i][2]);
+                double h     = std::atan2(static_cast<double>(lab[i][2]), static_cast<double>(lab[i][1]));
+                hue[i]       = std::fmod(h + 2 * PI, 2 * PI);
+                (chroma >= NEUTRAL_C ? chromatic : neutral).push_back(i);
+            }
+            std::vector<std::vector<size_t>> groups;
+            if (!chromatic.empty()) {
+                std::vector<size_t> order(chromatic);
+                std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) { return hue[a] < hue[b]; });
+                size_t start = 0;
+                double best  = -1;
+                for (size_t i = 0; i < order.size(); ++i) {
+                    double next = i + 1 < order.size() ? hue[order[i + 1]] : hue[order[0]] + 2 * PI;
+                    double gap  = next - hue[order[i]];
+                    if (gap > best) {
+                        best  = gap;
+                        start = i + 1;
+                    }
+                }
+                std::rotate(order.begin(), order.begin() + (start % order.size()), order.end());
+                std::vector<double> h;
+                for (size_t i : order) {
+                    h.push_back(hue[i]);
+                }
+                h = unwrap(h);
+                std::vector<size_t> cur{order[0]};
+                for (size_t i = 1; i < order.size(); ++i) {
+                    if (h[i] - h[i - 1] > hue_gap) {
+                        groups.push_back(cur);
+                        cur.clear();
+                    }
+                    cur.push_back(order[i]);
+                }
+                groups.push_back(cur);
+                std::vector<std::vector<size_t>> split;
+                for (auto g : groups) {
+                    while (g.size() > 2) {
+                        std::vector<double> hg;
+                        for (size_t i : g) {
+                            hg.push_back(hue[i]);
+                        }
+                        hg = unwrap(hg);
+                        if (hg.back() - hg.front() <= hue_span) {
+                            break;
+                        }
+                        size_t k = 1;
+                        for (size_t i = 1; i + 1 < hg.size(); ++i) {
+                            if (hg[i + 1] - hg[i] > hg[k] - hg[k - 1]) {
+                                k = i + 1;
+                            }
+                        }
+                        split.emplace_back(g.begin(), g.begin() + k);
+                        g.erase(g.begin(), g.begin() + k);
+                    }
+                    split.push_back(g);
+                }
+                groups = split;
+            }
+            auto assign = [&](int rid, const std::vector<size_t>& g) {
+                if (g.empty()) {
+                    return;
+                }
+                for (size_t i : g) {
+                    ramp[i] = rid;
+                }
+                if (g.size() > 1) {
+                    std::vector<size_t> idx(g.size());
+                    std::iota(idx.begin(), idx.end(), 0);
+                    std::stable_sort(idx.begin(), idx.end(), [&](size_t a, size_t b) { return lab[g[a]][0] < lab[g[b]][0]; });
+                    for (size_t rank = 0; rank < idx.size(); ++rank) {
+                        level[g[idx[rank]]] = static_cast<float>(rank) / static_cast<float>(g.size() - 1);
+                    }
+                }
+            };
+            assign(0, neutral);
+            for (size_t i = 0; i < groups.size(); ++i) {
+                assign(std::min(static_cast<int>(i) + 1, MAX_RAMPS), groups[i]);
+            }
+        }
+
+        // flow.extract_palette: one image's continuous guess [64*64*4] -> sorted unique sRGB colours.
+        std::vector<RGB> extract_palette(const std::vector<float>& x) {
+            std::vector<std::array<double, 3>> pts;
+            for (int q = 0; q < N_PIX; ++q) {
+                if (x[q * 4 + 3] > 0.f) {
+                    pts.push_back({static_cast<double>((x[q * 4 + 0] + 1.f) / 2.f),
+                                   static_cast<double>(x[q * 4 + 1] / AB_SCALE),
+                                   static_cast<double>(x[q * 4 + 2] / AB_SCALE)});
+                }
+            }
+            if (pts.empty()) {
+                return {};
+            }
+            std::map<std::array<int64_t, 3>, std::pair<std::array<double, 3>, int64_t>> bins;
+            for (const auto& p : pts) {
+                std::array<int64_t, 3> key;
+                for (int i = 0; i < 3; ++i) {
+                    key[i] = static_cast<int64_t>(std::nearbyint(p[i] / BIN_SIZE));
+                }
+                auto& bin = bins[key];
+                for (int i = 0; i < 3; ++i) {
+                    bin.first[i] += p[i];
+                }
+                bin.second += 1;
+            }
+            std::vector<std::array<double, 3>> means;
+            std::vector<int64_t> counts;
+            for (const auto& [key, bin] : bins) {
+                means.push_back({bin.first[0] / bin.second, bin.first[1] / bin.second, bin.first[2] / bin.second});
+                counts.push_back(bin.second);
+            }
+            std::vector<size_t> order(means.size());
+            std::iota(order.begin(), order.end(), 0);
+            std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) { return counts[a] > counts[b]; });
+            std::vector<std::array<double, 3>> centres;
+            for (size_t i : order) {
+                const auto& c = means[i];
+                double nearest = INFINITY;
+                for (const auto& k : centres) {
+                    nearest = std::min(nearest, std::sqrt((k[0] - c[0]) * (k[0] - c[0]) + (k[1] - c[1]) * (k[1] - c[1]) + (k[2] - c[2]) * (k[2] - c[2])));
+                }
+                if (centres.empty() || nearest > MERGE) {
+                    centres.push_back(c);
+                    if (static_cast<int>(centres.size()) >= MAX_COLOURS) {
+                        break;
+                    }
+                }
+            }
+            for (int it = 0; it < KMEANS_ITERS; ++it) {
+                std::vector<std::array<double, 3>> sums(centres.size(), {0, 0, 0});
+                std::vector<int64_t> n(centres.size(), 0);
+                for (const auto& p : pts) {
+                    size_t best_k = 0;
+                    double best_d = INFINITY;
+                    for (size_t k = 0; k < centres.size(); ++k) {
+                        double d = 0;
+                        for (int i = 0; i < 3; ++i) {
+                            d += (p[i] - centres[k][i]) * (p[i] - centres[k][i]);
+                        }
+                        if (d < best_d) {
+                            best_d = d;
+                            best_k = k;
+                        }
+                    }
+                    for (int i = 0; i < 3; ++i) {
+                        sums[best_k][i] += p[i];
+                    }
+                    n[best_k] += 1;
+                }
+                std::vector<std::array<double, 3>> next;
+                for (size_t k = 0; k < centres.size(); ++k) {
+                    if (n[k] > 0) {
+                        next.push_back({sums[k][0] / n[k], sums[k][1] / n[k], sums[k][2] / n[k]});
+                    }
+                }
+                centres = next;
+            }
+            std::set<RGB> unique;
+            for (const auto& c : centres) {
+                unique.insert(oklab_to_srgb(static_cast<float>(c[0]), static_cast<float>(c[1]), static_cast<float>(c[2])));
+            }
+            return {unique.begin(), unique.end()};
+        }
+
+        // "#aabbcc,#abc,..." -> sorted unique colours (at most 256).
+        std::vector<RGB> parse_palette(const char* text) {
+            std::set<RGB> colours;
+            if (text == nullptr) {
+                return {};
+            }
+            std::string all(text), item;
+            auto flush = [&]() {
+                std::string h;
+                for (char ch : item) {
+                    if (std::isxdigit(static_cast<unsigned char>(ch))) {
+                        h += ch;
+                    }
+                }
+                item.clear();
+                if (h.size() == 3) {
+                    h = std::string{h[0], h[0], h[1], h[1], h[2], h[2]};
+                }
+                if (h.size() != 6) {
+                    return;
+                }
+                colours.insert({static_cast<int>(std::strtol(h.substr(0, 2).c_str(), nullptr, 16)),
+                                static_cast<int>(std::strtol(h.substr(2, 2).c_str(), nullptr, 16)),
+                                static_cast<int>(std::strtol(h.substr(4, 2).c_str(), nullptr, 16))});
+            };
+            for (char ch : all) {
+                if (ch == ',' || ch == ';' || ch == ' ' || ch == ':') {
+                    flush();
+                } else {
+                    item += ch;
+                }
+            }
+            flush();
+            std::vector<RGB> out(colours.begin(), colours.end());
+            if (out.size() > MAX_PALETTE) {
+                out.resize(MAX_PALETTE);
+            }
+            return out;
+        }
+
+        // A palette as the network takes it, plus each slot's value in model space (index 0 = transparent).
+        struct Palette {
+            std::vector<RGB> colours;
+            sd::Tensor<float> feats;
+            sd::Tensor<int32_t> ramp;
+            sd::Tensor<float> level;
+            std::vector<std::array<float, 4>> model_space;
+
+            bool empty() const { return colours.empty(); }
+        };
+
+        Palette make_palette(std::vector<RGB> colours) {
+            Palette pal;
+            pal.colours     = std::move(colours);
+            const int64_t P = static_cast<int64_t>(pal.colours.size());
+            if (P == 0) {
+                return pal;
+            }
+            std::vector<std::array<float, 3>> lab64;
+            for (const auto& c : pal.colours) {
+                lab64.push_back(oklab_f64(c));
+            }
+            std::vector<int> ramp;
+            std::vector<float> level;
+            palette_ramps(lab64, ramp, level);
+            pal.feats = sd::Tensor<float>::zeros({RDFlow::COLOUR_FEATS, P});
+            pal.ramp  = sd::Tensor<int32_t>::zeros({P});
+            pal.level = sd::Tensor<float>::zeros({1, P});
+            pal.model_space.push_back({0.f, 0.f, 0.f, -1.f});
+            for (int64_t p = 0; p < P; ++p) {
+                auto lab = oklab_f32(pal.colours[p]);
+                float* f = pal.feats.data() + p * RDFlow::COLOUR_FEATS;
+                for (int i = 0; i < 3; ++i) {
+                    f[i] = lab[i];
+                    for (int k = 0; k < RDFlow::COLOUR_FREQS; ++k) {
+                        float freq = static_cast<float>(1 << k) * static_cast<float>(PI);
+                        float a    = lab[i] * freq;
+                        f[3 + i * RDFlow::COLOUR_FREQS + k]                              = std::sin(a);
+                        f[3 + 3 * RDFlow::COLOUR_FREQS + i * RDFlow::COLOUR_FREQS + k] = std::cos(a);
+                    }
+                }
+                pal.ramp.data()[p]  = std::min(std::max(ramp[p], 0), RDFlow::N_RAMPS - 1);
+                pal.level.data()[p] = level[p];
+                pal.model_space.push_back({2.f * lab[0] - 1.f, lab[1] * AB_SCALE, lab[2] * AB_SCALE, 1.f});
+            }
+            return pal;
+        }
+
+        // Softmax over (transparent, palette slots) per pixel; returns probabilities [N_PIX * K] and the expected
+        // model-space value [N_PIX * 4].
+        void pointer_expectation(const float* logits, const Palette& pal, std::vector<float>& probs, std::vector<float>& expected) {
+            const size_t K = pal.colours.size() + 1;
+            probs.assign(N_PIX * K, 0.f);
+            expected.assign(N_PIX * 4, 0.f);
+            for (int q = 0; q < N_PIX; ++q) {
+                const float* lg = logits + q * K;
+                float mx        = *std::max_element(lg, lg + K);
+                double sum      = 0;
+                for (size_t k = 0; k < K; ++k) {
+                    probs[q * K + k] = std::exp(lg[k] - mx);
+                    sum += probs[q * K + k];
+                }
+                for (size_t k = 0; k < K; ++k) {
+                    probs[q * K + k] = static_cast<float>(probs[q * K + k] / sum);
+                    for (int j = 0; j < 4; ++j) {
+                        expected[q * 4 + j] += probs[q * K + k] * pal.model_space[k][j];
+                    }
+                }
+            }
+        }
+
+        float bf16_round(float v) {
+            uint32_t u;
+            std::memcpy(&u, &v, sizeof(u));
+            if ((u & 0x7f800000u) != 0x7f800000u) {
+                u += 0x7fffu + ((u >> 16) & 1u);
+            }
+            u &= 0xffff0000u;
+            std::memcpy(&v, &u, sizeof(v));
+            return v;
+        }
+
+        // The prompt reader's features: per-token RMS normalisation without weight, rounded to bf16.
+        sd::Tensor<float> normalise_text(const sd::Tensor<float>& hidden) {
+            const int64_t D = hidden.shape()[0];
+            const int64_t L = hidden.shape()[1];
+            sd::Tensor<float> out({D, L});
+            for (int64_t i = 0; i < L; ++i) {
+                const float* h = hidden.data() + i * D;
+                double ss      = 0;
+                for (int64_t d = 0; d < D; ++d) {
+                    ss += static_cast<double>(h[d]) * h[d];
+                }
+                float inv = 1.f / std::sqrt(static_cast<float>(ss / D) + FLT_EPSILON);
+                for (int64_t d = 0; d < D; ++d) {
+                    out.data()[i * D + d] = bf16_round(h[d] * inv);
+                }
+            }
+            return out;
+        }
+
+        // torch.linspace(0, 1, steps + 1) then t / (t + shift * (1 - t)), in float32.
+        std::vector<float> time_grid(int steps) {
+            std::vector<float> ts(steps + 1);
+            const float step = 1.f / static_cast<float>(steps);
+            const int half   = (steps + 1) / 2;
+            for (int i = 0; i <= steps; ++i) {
+                ts[i] = i < half ? step * static_cast<float>(i) : 1.f - step * static_cast<float>(steps - i);
+            }
+            for (auto& t : ts) {
+                t = t / (t + FLOW_SHIFT * (1.f - t));
+            }
+            return ts;
+        }
+
+        struct SampleResult {
+            std::vector<RGB> colours;
+            std::vector<int> tokens;
+        };
+
+        class Sampler {
+        public:
+            Sampler(StableDiffusionGGML* sd, RDFlow::RDFlowRunner* runner, bool transparent, int steps, float guidance)
+                : sd_(sd), runner_(runner), transparent_(transparent), steps_(steps), guidance_(guidance) {}
+
+            bool sample(std::vector<float> x, const std::vector<RGB>& locked, SampleResult& result) {
+                Palette pal = locked.empty() ? Palette{} : make_palette(locked);
+                std::vector<float> x_hat, sc(N_PIX * 4, 0.f), probs;
+                const auto ts = time_grid(steps_);
+                for (int i = 0; i < steps_; ++i) {
+                    const float t = ts[i], t2 = ts[i + 1];
+                    if (pal.empty() && t >= PALETTE_AT && !x_hat.empty()) {
+                        pal = make_palette(extract_palette(x_hat));
+                    }
+                    const bool guide   = guidance_ != 1.f && GUIDE_FROM <= t && t <= GUIDE_UNTIL;
+                    const bool pointer = !pal.empty() && t >= POINTER_FROM;
+                    std::vector<float> cond_out, uncond_out;
+                    if (!call(x, sc, t, true, pal, cond_out) || (guide && !call(x, sc, t, false, pal, uncond_out))) {
+                        return false;
+                    }
+                    x_hat.assign(N_PIX * 4, 0.f);
+                    for (int k = 0; k < N_PIX * 4; ++k) {
+                        x_hat[k] = guide ? uncond_out[k] + guidance_ * (cond_out[k] - uncond_out[k]) : cond_out[k];
+                    }
+                    if (pointer) {
+                        std::vector<float> expected, uncond_probs, uncond_expected;
+                        pointer_expectation(cond_out.data() + N_PIX * 4, pal, probs, expected);
+                        if (guide) {
+                            pointer_expectation(uncond_out.data() + N_PIX * 4, pal, uncond_probs, uncond_expected);
+                            for (int k = 0; k < N_PIX * 4; ++k) {
+                                expected[k] = uncond_expected[k] + guidance_ * (expected[k] - uncond_expected[k]);
+                            }
+                        }
+                        if (t >= COMMIT_FROM) {
+                            commit(probs, pal, expected);
+                        }
+                        x_hat = expected;
+                    }
+                    sc              = x_hat;
+                    const float den = std::max(1.f - t, 1e-4f);
+                    for (int k = 0; k < N_PIX * 4; ++k) {
+                        x[k] = x[k] + (t2 - t) * (x_hat[k] - x[k]) / den;
+                    }
+                    sd_->generation_progress.report("sampling", "rd_flow", i + 1, steps_, "steps");
+                }
+                if (pal.empty() || probs.empty()) {
+                    LOG_ERROR("RD Flow 64 finished without a palette");
+                    return false;
+                }
+                result.colours = pal.colours;
+                result.tokens  = argmax_tokens(probs, pal.colours.size() + 1);
+                return true;
+            }
+
+        private:
+            bool call(const std::vector<float>& x, const std::vector<float>& sc, float t, bool conditional, const Palette& pal, std::vector<float>& out) {
+                RDFlow::CallInputs in;
+                in.x           = sd::Tensor<float>({RDFlow::CHANNELS, RDFlow::SIZE, RDFlow::SIZE}, x);
+                in.sc          = sd::Tensor<float>({RDFlow::CHANNELS, RDFlow::SIZE, RDFlow::SIZE}, sc);
+                in.t           = t;
+                in.conditional = conditional;
+                in.transparent = transparent_;
+                if (!pal.empty()) {
+                    in.pal_feats = pal.feats;
+                    in.pal_ramp  = pal.ramp;
+                    in.pal_level = pal.level;
+                }
+                auto result = runner_->run(sd_->n_threads, in);
+                if (result.empty()) {
+                    LOG_ERROR("RD Flow 64 network call failed");
+                    return false;
+                }
+                out.assign(result.data(), result.data() + result.numel());
+                return true;
+            }
+
+            static void commit(const std::vector<float>& probs, const Palette& pal, std::vector<float>& expected) {
+                const size_t K = pal.colours.size() + 1;
+                for (int q = 0; q < N_PIX; ++q) {
+                    const float* p = probs.data() + q * K;
+                    size_t best    = static_cast<size_t>(std::max_element(p, p + K) - p);
+                    if (p[best] >= COMMIT_THRESH) {
+                        for (int j = 0; j < 4; ++j) {
+                            expected[q * 4 + j] = pal.model_space[best][j];
+                        }
+                    }
+                }
+            }
+
+            static std::vector<int> argmax_tokens(const std::vector<float>& probs, size_t K) {
+                std::vector<int> tokens(N_PIX);
+                for (int q = 0; q < N_PIX; ++q) {
+                    const float* p = probs.data() + q * K;
+                    tokens[q]      = static_cast<int>(std::max_element(p, p + K) - p);
+                }
+                return tokens;
+            }
+
+            StableDiffusionGGML* sd_;
+            RDFlow::RDFlowRunner* runner_;
+            bool transparent_;
+            int steps_;
+            float guidance_;
+        };
+
+        sd_image_t decode_image(const SampleResult& result) {
+            sd_image_t image{RDFlow::SIZE, RDFlow::SIZE, 4, static_cast<uint8_t*>(calloc(N_PIX * 4, 1))};
+            for (int q = 0; q < N_PIX; ++q) {
+                const int token = result.tokens[q];
+                if (token > 0) {
+                    const auto& c        = result.colours[token - 1];
+                    image.data[q * 4 + 0] = static_cast<uint8_t>(c[0]);
+                    image.data[q * 4 + 1] = static_cast<uint8_t>(c[1]);
+                    image.data[q * 4 + 2] = static_cast<uint8_t>(c[2]);
+                    image.data[q * 4 + 3] = 255;
+                }
+            }
+            return image;
+        }
+
+        sd::Tensor<float> encode_prompt(StableDiffusionGGML* sd, const std::string& prompt) {
+            ConditionerRunnerEndOnExit conditioner_runner_end{sd->cond_stage_model.get()};
+            ConditionerParams condition_params;
+            condition_params.text = prompt;
+            sd->generation_progress.report("conditioning", "positive_prompt");
+            auto cond = sd->get_learned_condition(condition_params);
+            if (cond.c_crossattn.empty()) {
+                return {};
+            }
+            return normalise_text(cond.c_crossattn);
+        }
+    }  // namespace
+
+    bool generate_rd_flow(StableDiffusionGGML* sd,
+                          const sd_img_gen_params_t* params,
+                          const GenerationRequest& request,
+                          const nlohmann::json& info,
+                          sd_image_t** images_out,
+                          int* num_images_out,
+                          std::vector<nlohmann::json>* infos_out) {
+        auto runner = std::dynamic_pointer_cast<RDFlow::RDFlowRunner>(sd->diffusion_model);
+        if (runner == nullptr) {
+            LOG_ERROR("RD Flow 64 diffusion model is not loaded");
+            return false;
+        }
+        if (request.width != RDFlow::SIZE || request.height != RDFlow::SIZE) {
+            LOG_WARN("RD Flow 64 draws %dx%d only; ignoring the requested %dx%d", RDFlow::SIZE, RDFlow::SIZE, request.width, request.height);
+        }
+        int64_t t0 = ggml_time_ms();
+        auto text  = encode_prompt(sd, request.prompt);
+        if (text.empty()) {
+            LOG_ERROR("failed to encode prompt");
+            return false;
+        }
+        runner->set_text(text);
+        int64_t t1 = ggml_time_ms();
+        LOG_INFO("RD Flow 64 prompt read (%" PRId64 " tokens) in %.2fs", text.shape()[1], (t1 - t0) / 1000.f);
+
+        const auto locked      = parse_palette(params->palette);
+        const bool transparent = !params->opaque_background;
+        const int steps        = request.sample_params.sample_steps > 0 ? request.sample_params.sample_steps : 16;
+        const float guidance   = request.guidance.txt_cfg;
+        LOG_INFO("RD Flow 64: %d steps, guidance %.2f, %s, palette %s", steps, guidance,
+                 transparent ? "transparent" : "opaque",
+                 locked.empty() ? "chosen by the model" : (std::to_string(locked.size()) + " locked colours").c_str());
+
+        std::vector<sd_image_t> images;
+        Sampler sampler(sd, runner.get(), transparent, steps, guidance);
+        for (int b = 0; b < request.batch_count; ++b) {
+            if (sd->get_cancel_flag() == SD_CANCEL_ALL || sd->get_cancel_flag() == SD_CANCEL_NEW_LATENTS) {
+                break;
+            }
+            sd->rng->manual_seed(request.seed_for_batch(b));
+            std::vector<float> noise = sd->rng->randn(N_PIX * 4);
+            SampleResult result;
+            if (!sampler.sample(std::move(noise), locked, result)) {
+                for (auto& image : images) {
+                    free(image.data);
+                }
+                runner->runner_end();
+                return false;
+            }
+            images.push_back(decode_image(result));
+        }
+        runner->runner_end();
+        LOG_INFO("RD Flow 64 drew %zu image(s) in %.2fs", images.size(), (ggml_time_ms() - t1) / 1000.f);
+
+        auto* out = static_cast<sd_image_t*>(calloc(images.size() > 0 ? images.size() : 1, sizeof(sd_image_t)));
+        std::copy(images.begin(), images.end(), out);
+        if (infos_out) {
+            infos_out->assign(images.size(), info);
+            for (size_t i = 0; i < images.size(); ++i) {
+                (*infos_out)[i]["seed"] = std::to_string(request.seed_for_batch(static_cast<int>(i)));
+            }
+        }
+        if (num_images_out != nullptr) {
+            *num_images_out = static_cast<int>(images.size());
+        }
+        if (images_out != nullptr) {
+            *images_out = out;
+        } else {
+            free_sd_images(out, static_cast<int>(images.size()));
+        }
+        return true;
+    }
+}  // namespace sd::pipeline
